NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private stable signing key, shared by all Vercel instances. At least 32 random characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Server only; required before applying server_access_hardening.sql and for atomic promotions.
# Do not expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=
